{% extends 'base.html.twig' %}

{% block title %}Assuntos - Sistema de Livros{% endblock %}

{% block body %}
<div class="py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Assuntos</h1>
            <p class="text-muted mb-0">Gerenciamento de assuntos cadastrados.</p>
        </div>

        <a href="{{ path('assunto_novo') }}" class="btn btn-primary">
            Novo assunto
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="btn-group" role="group">
            <a href="{{ path('assunto_listar', {status: 'ativos'}) }}"
               class="btn btn-sm {{ status == 'ativos' ? 'btn-primary' : 'btn-outline-primary' }}">
                Ativos
            </a>

            <a href="{{ path('assunto_listar', {status: 'inativos'}) }}"
               class="btn btn-sm {{ status == 'inativos' ? 'btn-primary' : 'btn-outline-primary' }}">
                Inativos
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Código</th>
                            <th scope="col">Descrição</th>
                            <th scope="col" class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for assunto in assuntos %}
                            <tr>
                                <td>{{ assunto.id }}</td>
                                <td>{{ assunto.descricao }}</td>
                                <td class="text-end">

                                    {% if assunto.ativo %}
                                        <a href="{{ path('assunto_editar', {id: assunto.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form method="post"
                                              action="{{ path('assunto_inativar', {id: assunto.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Deseja realmente inativar este assunto?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('inativar_assunto_' ~ assunto.id) }}">

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Inativar
                                            </button>
                                        </form>

                                    {% else %}

                                        <form method="post"
                                              action="{{ path('assunto_reativar', {id: assunto.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Deseja realmente reativar este assunto?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('reativar_assunto_' ~ assunto.id) }}">

                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Reativar
                                            </button>
                                        </form>

                                    {% endif %}

                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    Nenhum assunto {{ status == 'ativos' ? 'ativo' : 'inativo' }} encontrado.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
{% endblock %}
