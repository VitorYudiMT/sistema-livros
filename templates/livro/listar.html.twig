{% extends 'base.html.twig' %}

{% block title %}Livros - Sistema de Livros{% endblock %}

{% block body %}
<div class="py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Livros</h1>
            <p class="text-muted mb-0">Gerenciamento de livros cadastrados.</p>
        </div>

        <a href="{{ path('livro_novo') }}" class="btn btn-primary">
            Novo livro
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="btn-group" role="group">
            <a href="{{ path('livro_listar', {status: 'ativos'}) }}"
               class="btn btn-sm {{ status == 'ativos' ? 'btn-primary' : 'btn-outline-primary' }}">
                Ativos
            </a>

            <a href="{{ path('livro_listar', {status: 'inativos'}) }}"
               class="btn btn-sm {{ status == 'inativos' ? 'btn-primary' : 'btn-outline-primary' }}">
                Inativos
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Título</th>
                            <th>Autores</th>
                            <th>Assuntos</th>
                            <th>Editora</th>
                            <th>Edição</th>
                            <th>Ano</th>
                            <th>Valor</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for livro in livros %}
                            <tr>
                                <td>{{ livro.id }}</td>

                                <td>{{ livro.titulo }}</td>

                                <td>
                                    {% for autor in livro.autores %}
                                        {{ autor.nome }}{% if not loop.last %}, {% endif %}
                                    {% else %}
                                        <span class="text-muted">Não informado</span>
                                    {% endfor %}
                                </td>

                                <td>
                                    {% for assunto in livro.assuntos %}
                                        {{ assunto.descricao }}{% if not loop.last %}, {% endif %}
                                    {% else %}
                                        <span class="text-muted">Não informado</span>
                                    {% endfor %}
                                </td>

                                <td>{{ livro.editora }}</td>

                                <td>{{ livro.edicao }}</td>

                                <td>{{ livro.anoPublicacao }}</td>

                                <td>
                                    R$ {{ livro.valor|number_format(2, ',', '.') }}
                                </td>

                                <td class="text-end text-nowrap">

                                    {% if livro.ativo %}

                                        <a href="{{ path('livro_editar', {id: livro.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form method="post"
                                              action="{{ path('livro_inativar', {id: livro.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Deseja realmente inativar este livro?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('inativar_livro_' ~ livro.id) }}">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Inativar
                                            </button>
                                        </form>

                                    {% else %}

                                        <form method="post"
                                              action="{{ path('livro_reativar', {id: livro.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Deseja realmente reativar este livro?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('reativar_livro_' ~ livro.id) }}">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Reativar
                                            </button>
                                        </form>

                                    {% endif %}

                                </td>
                            </tr>

                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    Nenhum livro {{ status == 'ativos' ? 'ativo' : 'inativo' }} encontrado.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
{% endblock %}
