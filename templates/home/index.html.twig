
{% extends 'base.html.twig' %}

{% block title %}
    {{ dados.titulo }}
{% endblock %}

{% block body %}

<section class="mb-4">
    <h1 class="h3 mb-2">{{ dados.titulo }}</h1>
    <p class="text-muted mb-0">{{ dados.descricao }}</p>
</section>

<section>
    <div class="row g-4">

        {# LIVROS #}
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 module-card"
                 data-href="{{ path('livro_listar') }}"
                 role="link"
                 tabindex="0"
                 aria-label="Acessar livros">

                <div class="card-body d-flex flex-column">

                    <div class="rounded-3 bg-primary-subtle text-primary
                                d-flex align-items-center justify-content-center mb-3"
                         style="width: 48px; height: 48px;">
                        <span class="fw-bold fs-5">L</span>
                    </div>

                    <h2 class="h5">Livros</h2>

                    <p class="text-muted">
                        Cadastre, consulte, edite e gerencie os livros
                        do sistema.
                    </p>

                    <div class="mt-auto pt-2">
                        <a href="{{ path('livro_novo') }}"
                           class="btn btn-outline-primary btn-sm"
                           aria-label="Cadastrar novo livro">
                            <i class="bi bi-plus-lg"></i>
                            Novo livro
                        </a>
                    </div>

                </div>
            </div>
        </div>

        {# AUTORES #}
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 module-card"
                 data-href="{{ path('autor_listar') }}"
                 role="link"
                 tabindex="0"
                 aria-label="Acessar autores">

                <div class="card-body d-flex flex-column">

                    <div class="rounded-3 bg-primary-subtle text-primary
                                d-flex align-items-center justify-content-center mb-3"
                         style="width: 48px; height: 48px;">
                        <span class="fw-bold fs-5">A</span>
                    </div>

                    <h2 class="h5">Autores</h2>

                    <p class="text-muted">
                        Gerencie os autores e seus vínculos com
                        os livros cadastrados.
                    </p>

                    <div class="mt-auto pt-2">
                        <a href="{{ path('autor_novo') }}"
                           class="btn btn-outline-primary btn-sm"
                           aria-label="Cadastrar novo autor">
                            <i class="bi bi-plus-lg"></i>
                            Novo autor
                        </a>
                    </div>

                </div>
            </div>
        </div>

        {# ASSUNTOS #}
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 module-card"
                 data-href="{{ path('assunto_listar') }}"
                 role="link"
                 tabindex="0"
                 aria-label="Acessar assuntos">

                <div class="card-body d-flex flex-column">

                    <div class="rounded-3 bg-primary-subtle text-primary
                                d-flex align-items-center justify-content-center mb-3"
                         style="width: 48px; height: 48px;">
                        <span class="fw-bold fs-5">A</span>
                    </div>

                    <h2 class="h5">Assuntos</h2>

                    <p class="text-muted">
                        Gerencie os assuntos utilizados na classificação
                        dos livros.
                    </p>

                    <div class="mt-auto pt-2">
                        <a href="{{ path('assunto_novo') }}"
                           class="btn btn-outline-primary btn-sm"
                           aria-label="Cadastrar novo assunto">
                            <i class="bi bi-plus-lg"></i>
                            Novo assunto
                        </a>
                    </div>

                </div>
            </div>
        </div>

        {# RELATÓRIOS #}
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 module-card"
                 data-href="{{ path('relatorio_livros') }}"
                 role="link"
                 tabindex="0"
                 aria-label="Acessar relatórios">

                <div class="card-body d-flex flex-column">

                    <div class="rounded-3 bg-primary-subtle text-primary
                                d-flex align-items-center justify-content-center mb-3"
                         style="width: 48px; height: 48px;">
                        <span class="fw-bold fs-5">R</span>
                    </div>

                    <h2 class="h5">Relatórios</h2>

                    <p class="text-muted">
                        Consulte livros agrupados por autor, com filtros
                        de situação e assunto.
                    </p>

                </div>
            </div>
        </div>

    </div>
</section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/home/index.js') }}" defer></script>
{% endblock %}
