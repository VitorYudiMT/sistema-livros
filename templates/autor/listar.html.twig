{% extends 'base.html.twig' %}

{% block title %}Autores - Sistema de Livros{% endblock %}

{% block body %}
<div class="py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Autores</h1>
            <p class="text-muted mb-0">Gerenciamento de autores cadastrados.</p>
        </div>

        <a href="{{ path('autor_novo') }}" class="btn btn-primary">
            Novo autor
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="btn-group" role="group">
            <a href="{{ path('autor_listar', {status: 'ativos'}) }}"
               class="btn btn-sm {{ status == 'ativos' ? 'btn-primary' : 'btn-outline-primary' }}">
                Ativos
            </a>

            <a href="{{ path('autor_listar', {status: 'inativos'}) }}"
               class="btn btn-sm {{ status == 'inativos' ? 'btn-primary' : 'btn-outline-primary' }}">
                Inativos
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Código</th>
                            <th scope="col">Nome</th>
                            <th scope="col" class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for autor in autores %}
                            <tr>
                                <td>{{ autor.id }}</td>
                                <td>{{ autor.nome }}</td>
                                <td class="text-end">

                                    {% if autor.ativo %}
                                        <a href="{{ path('autor_editar', {id: autor.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form method="post"
                                              action="{{ path('autor_inativar', {id: autor.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Deseja realmente inativar este autor?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('inativar_autor_' ~ autor.id) }}">

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Inativar
                                            </button>
                                        </form>

                                    {% else %}

                                        <form method="post"
                                              action="{{ path('autor_reativar', {id: autor.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Deseja realmente reativar este autor?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('reativar_autor_' ~ autor.id) }}">

                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Reativar
                                            </button>
                                        </form>

                                    {% endif %}

                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    Nenhum autor {{ status == 'ativos' ? 'ativo' : 'inativo' }} encontrado.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
{% endblock %}